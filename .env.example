# Copia este archivo como .env.local y llena los valores. .env.local NO se sube a GitHub.
# Local (npx supabase start muestra estos valores):
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=pega-aqui-la-anon-key
# URL pública del sitio (para enlaces de correo y SEO)
VITE_SITE_URL=http://localhost:5173
# Opcional: token de Cloudflare Web Analytics. Solo se activa si el visitante acepta cookies de analítica.
VITE_CF_ANALYTICS_TOKEN=
